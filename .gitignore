# ===========================================================================
#  CASHYPHUS
#  The game ships from source alone: every sprite and every sound is generated
#  in code, so there are deliberately NO binary assets in this repository.
#  Anything listed here is a build artefact or a local development by-product.
# ===========================================================================

# --- Build trees -----------------------------------------------------------
# raylib is fetched into these, so they get large (hundreds of MB).
/build/
/build-*/
/cmake-build-*/
/out/
_install/

# --- CMake scratch (in case someone configures in-source) -------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
/ninja/
/Makefile
/build.ninja
/.ninja_deps
/.ninja_log

# --- Compiled objects and libraries ----------------------------------------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe

# --- Build products if configured in-source (normally they live in build/) --
/cashyphus
/cashyphus_tests
/cashyphus_dump_sprites
/cashyphus.html
/cashyphus.js
/cashyphus.wasm
/cashyphus.data
/cashyphus.worker.js

# --- Development tool output -----------------------------------------------
# cashyphus_dump_sprites writes sprite-sheet previews and
# cashyphus --capture writes a PNG per phase.
sprites_preview*.png
/shot*.png
/shots/
*.log

# --- Editor / IDE ----------------------------------------------------------
.vscode/
.idea/
.clangd/
.cache/
*.code-workspace
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
