# ===========================================================================
#  CASHYPHUS
#  Every sprite is still generated in code, and the pixel font in assets/fonts/
#  is baked into a C++ table at authoring time (tools/gen_font.py). The audio is
#  the one thing that ships as files: the edited CC0 recordings in assets/audio/
#  are loaded at runtime, so that directory is committed. Anything listed here is
#  a build artefact, a re-baking input, or a local development by-product.
# ===========================================================================

# --- Build trees -----------------------------------------------------------
# raylib is fetched into these, so they get large (hundreds of MB).
/build/
/build-*/
/cmake-build-*/
/out/
_install/

# --- CMake scratch (in case someone configures in-source) -------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
/ninja/
/Makefile
/build.ninja
/.ninja_deps
/.ninja_log

# --- Compiled objects and libraries ----------------------------------------
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe

# --- Build products if configured in-source (normally they live in build/) --
/cashyphus
/cashyphus_tests
/cashyphus_dump_sprites
/cashyphus.html
/cashyphus.js
/cashyphus.wasm
/cashyphus.data
/cashyphus.worker.js

# --- GitHub Pages staging (created by .github/workflows/pages.yml) ----------
/dist/

# --- Development tool output -----------------------------------------------
# cashyphus_dump_sprites writes sprite-sheet previews and
# cashyphus --capture writes a PNG per phase.
sprites_preview*.png
/shot*.png
/shots/
*.log

# --- Editor / IDE ----------------------------------------------------------
.vscode/
.idea/
.clangd/
.cache/
*.code-workspace
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Python (the asset bakers in tools/ are the only Python here) -----------
__pycache__/
*.py[cod]

# --- Audio re-baking inputs -------------------------------------------------
# The recordings the effects and loops are cut from, kept on disk so
# tools/build_audio.py can be re-run, but not committed: the game loads the
# rendered files in assets/audio/{sfx,music,ambience}/ and SOURCES.md records
# the author, URL and licence of every input, so they can always be fetched
# again.
/assets/audio/sources/

# macOS resource forks, which a zip built on a Mac leaves beside every file
# (ten of them arrived inside the coin_sounds archive).
._*
